local function IsPointInGuiButton(guiButton, inputPoint)
if not guiButton or not
guiButton.Parent then
    return false
end
local val = guiButton.AbsolutePosition
local computedVal = guiButton.AbsoluteSize
local val = val.X + computedVal.X / 2
local val = val.Y + computedVal.Y / 2
local computedVal = math.min(computedVal.X, computedVal.Y) / 2 * 0.8
local val = inputPoint.X - val
local val = inputPoint.Y - val
return(val * val + val * val) <= (computedVal * computedVal)
end
