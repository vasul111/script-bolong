local function FindSkillCheckUiElements()
for key, value in ipairs( {"SkillCheckPromptGui", "SkillCheckPromptGuiCon"})do
    local val = PlayerGui:FindFirstChild(value, true)
    if val then
        local check = val:FindFirstChild("Check", true)
