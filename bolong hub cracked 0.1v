                    local vec3Pos = humanoidRootPart28.AssemblyLinearVelocity
                    local targetPosition34 = Vector3.new(vec3Pos.X, 0, vec3Pos.Z)
                    if targetPosition34.Magnitude > 65 then
                        targetPosition34 = targetPosition34.Unit * 65
                    end CheatState.silentSpearTargetVel = targetPosition34
                    local spearAimVector, spearFlightTimeSeconds = SolveSpearTrajectory(taskInterval, spearAimTargetPos, effectiveSpearVelocity, val)
                    if spearAimVector and spearFlightTimeSeconds then
                        local leadTargetOffset = CheatState.silentSpearTargetVel * spearFlightTimeSeconds
                        local leadSpearAimTargetPos = spearAimTargetPos + leadTargetOffset
                        local leadSpearAimVector, leadSpearFlightTimeSeconds = SolveSpearTrajectory(taskInterval, leadSpearAimTargetPos, effectiveSpearVelocity, val)
                        if leadSpearAimVector then
                            CheatState.silentSpearTargetTorso = leadSpearAimTargetPos
                            CheatState.silentSpearLookVector = leadSpearAimVector
                        else
                            CheatState.silentSpearTargetTorso = nil
                            CheatState.silentSpearLookVector = nil
                        end
                    else
                        CheatState.silentSpearTargetTorso = nil
                        CheatState.silentSpearLookVector = nil
                    end
                else
                    CheatState.silentSpearTargetTorso = nil
                    CheatState.silentSpearLookVector = nil
                end
            else
                CheatState.silentSpearTargetTorso = nil
                CheatState.silentSpearLookVector = nil
            end
        else
            CheatState.silentSpearTargetTorso = nil
            CheatState.silentSpearLookVector = nil
        end
    else
        CheatState.silentSpearTargetTorso = nil
        CheatState.silentSpearLookVector = nil
    end
end)
end function Hub.SetupPlayer(player, character)
if player == LocalPlayer then
    return
end SetEspAdornee(player, character)
SetHighlightOutline(player, character)
if Config.hitboxEnabled then
    task.wait(0.3)
    SetPlayerHitbox(player, character)
end
if Config.hitboxEspEnabled then
    SetupHitboxEsp(player, character)
end
if CheatState.autoParryEnabled or AutoParryState.Enabled then
    Hub.TrackKillerAnimations(player, character)
end
end function Hub.OnPlayerAdded(player)
if player == LocalPlayer then
    return
end UpdatePlayerRole(player)
SetupPlayerEsp(player)
SetupPlayerOutline(player)
player:GetPropertyChangedSignal("Team"):Connect(function()
    UpdatePlayerRole(player)
    task.wait(0.2)
    if CheatState.autoParryEnabled or AutoParryState.Enabled then
        Hub.TrackKillerAnimations(player)
    end
end)
if player.Character then
    task.spawn(function()
        Hub.SetupPlayer(player, player.Character)
    end)
end player.CharacterAdded:Connect(function(character)
    task.spawn(function()
        Hub.SetupPlayer(player, character)
    end)
end)
end function Hub.OnPlayerRemoving(player)
RemovePlayerEsp(player)
RemoveHitboxEsp(player)
if player.Character then
    ResetPlayerHitbox(player, player.Character)
end for key, AutoParryState in pairs(AutoParryState.KillerConns)do
    if not key.Parent then
        AutoParryState:Disconnect()
        AutoParryState.KillerConns[key] = nil
    end
end
end Players.PlayerAdded:Connect(Hub.OnPlayerAdded)
Players.PlayerRemoving:Connect(Hub.OnPlayerRemoving)
for key, value in ipairs(Players:GetPlayers())do
    if value ~= LocalPlayer then
        Hub.OnPlayerAdded(value)
    end
end function Hub.OnCharacterAdded(character)
CheatState.HoldLockActive = false
CheatState.godLastHP = nil
AutoParryState.CachedBtn = nil;AutoParryState.WarnedMissing = false
CheatState.CV_HoldingPC = false
CheatState.CV_HoldingMobile = false
ResetCameraVeilTarget()
if CheatState.CV_Enabled then
    task.defer(HookMobileButtons)
end task.spawn(SetupMovementCheats, character)
if CheatState.godEnabled then
    task.wait(0.3)
    DisableGodMode()
    EnableGodMode()
end
if Config.lockFovEnabled then
    task.wait(0.1)
    CheatState.originalFOV = nil
    SetFov(Config.customFovValue)
end
if Config.cameraZoomEnabled then
    task.wait(0.1)
    CheatState.originalMaxZoom = nil
    SetMaxZoom(Config.cameraZoomValue)
end task.wait(1)
if PlayerGui:FindFirstChild("SurvivorMob")then
    Hub.GetParryButton()
else
    Hub.InitializeParryButton()
end
end
if LocalPlayer.Character then
    task.spawn(Hub.OnCharacterAdded, LocalPlayer.Character)
end LocalPlayer.CharacterAdded:Connect(function(character)
    task.spawn(Hub.OnCharacterAdded, character)
end)
RunService.Heartbeat:Connect(function(connection)
    for i = 1, #TaskLoops do
        local val = TaskLoops[i]
        val.timer = val.timer + connection
        if val.timer >= val.interval then
            val.timer = 0
            val.fn(connection)
        end
    end
end)
