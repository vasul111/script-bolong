    val ~= "killer"then
        continue
    end
    if Config.cameralockTargetType == "Survivor"
    and
    val ~= "survivor"then
        continue
    end
    local val = (val - targetPosition6).Magnitude
    if val < val then
        val = val
        val = value
    end
end return val
end
