local function CalculateSpearFlightTime(distanceX, pitchAngle, launchSpeed, gravityForce)
local CheckTrajectoryAccuracy = math.cos(pitchAngle)
if CheckTrajectoryAccuracy <= 0.015 then
    return nil, nil
end
local spearFlightTime = distanceX / (launchSpeed * CheckTrajectoryAccuracy)
if spearFlightTime ~= spearFlightTime or spearFlightTime <= 0 then
    return nil, nil
end
local simDeltaTime = 1 / 60
local simGravityComp = 0.5 * gravityForce * simDeltaTime * spearFlightTime
local simHeightY = launchSpeed * math.sin(pitchAngle) * spearFlightTime - (0.5 * gravityForce * spearFlightTime * spearFlightTime) - simGravityComp
return simHeightY, spearFlightTime
end
local function ScoreSpearTrajectory(distanceX, distanceY, pitchAngle, launchSpeed, gravityForce)
local calculatedSpearY, simSpearFlightTime = CalculateSpearFlightTime(distanceX, pitchAngle, launchSpeed, gravityForce)
if not calculatedSpearY or not
simSpearFlightTime then
    return nil
end
if simSpearFlightTime < 0.025 or simSpearFlightTime > 5 then
    return nil
end
local spearHeightDelta = math.abs(calculatedSpearY - distanceY)
local spearAnglePenalty = math.max(pitchAngle - Angle42Rad, 0) * 0.35
local spearTimePenalty = math.max(simSpearFlightTime - 1.3, 0) * 0.25
return spearHeightDelta + spearAnglePenalty + spearTimePenalty, spearHeightDelta, simSpearFlightTime
end
local function SolveSpearTrajectory(originPos, targetPos, launchSpeed, gravityForce)
if launchSpeed <= 0 then
    launchSpeed = 142.5
end
if gravityForce <= 0 then
    gravityForce = 196.2
end
local spearTargetOffset = targetPos - originPos
local targetPosition26 = Vector3.new(spearTargetOffset.X, 0, spearTargetOffset.Z)
local spearHorizontalDist = targetPosition26.Magnitude
local spearHeightDiff = spearTargetOffset.Y
if spearTargetOffset.Magnitude <= 0.001 then
    return nil
end
if spearHorizontalDist <= 0.35 or gravityForce <= 0.001 then
    return spearTargetOffset.Unit, math.clamp(spearTargetOffset.Magnitude / launchSpeed, 0.025, 5)
end
local spearHorizontalDir = targetPosition26.Unit
local spearDirectAngle = math.atan2(spearHeightDiff, spearHorizontalDist)
local spearMinPitch = math.max( - Angle28Rad, spearDirectAngle - Angle18Rad)
local spearMaxPitch = Angle72Rad
local bestSpearPitch, bestSpearScore, bestSpearDeltaY, bestSpearTime = nil, math.huge, math.huge, nil
local spearSearchSteps = 30
for i = 0, spearSearchSteps do
    local spearSamplePitch = spearMinPitch + (spearMaxPitch - spearMinPitch) * (i / spearSearchSteps)
    local spearSampleScore, spearSampleDeltaY, spearSampleTime = ScoreSpearTrajectory(spearHorizontalDist, spearHeightDiff, spearSamplePitch, launchSpeed, gravityForce)
    if spearSampleScore and spearSampleScore < bestSpearScore then
        bestSpearScore, bestSpearDeltaY, bestSpearPitch, bestSpearTime = spearSampleScore, spearSampleDeltaY, spearSamplePitch, spearSampleTime
        if bestSpearDeltaY < val then
            break
        end
    end
end
if bestSpearPitch then
    local clamped = (spearMaxPitch - spearMinPitch) / spearSearchSteps * 2.5
    local spearRefineSteps = (bestSpearDeltaY < val)
    and 1
    or 4
    for i = 1, spearRefineSteps do
