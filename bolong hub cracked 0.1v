-- ============================================================================
-- MODULE 4: Hitbox Expander & Visualizer
-- ============================================================================
local function SetPlayerHitbox(player, hitboxSize)
if not Config.hitboxEnabled then
    return
end
local collection = SetupPlayerConnections(hitboxSize)
local val = GetPlayerRole(player)
local val = (val == "killer") and Config.killerHitboxSize or Config.survivorHitboxSize
local hitboxScale = val / 100
for key, value in ipairs(collection)do
    if not CheatState.hitboxOriginalSizes[value]then
        CheatState.hitboxOriginalSizes[value] = value.Size
    end value.Size = CheatState.hitboxOriginalSizes[value] * hitboxScale
end
end
local function ResetPlayerHitbox(player, originalSize)
if not originalSize then
    return
end for key, value in ipairs(originalSize:GetDescendants())do
    if value:IsA("BasePart")then
        local originalHitboxSize = CheatState.hitboxOriginalSizes[value]
        if originalHitboxSize then
            value.Size = originalHitboxSize
            CheatState.hitboxOriginalSizes[value] = nil
        end
    end
end
end
local function ApplyAllHitboxes()
if not Config.hitboxEnabled then
    return
end for key, value in ipairs(Players:GetPlayers())do
    if value ~= LocalPlayer and value.Character then
        SetPlayerHitbox(value, value.Character)
    end
end
end
local function RestoreAllHitboxes()
for key, value in ipairs(Players:GetPlayers())do
    if value ~= LocalPlayer and value.Character then
        ResetPlayerHitbox(value, value.Character)
    end
end
end
local function SetupHitboxEsp(player, boxColor)
if player == LocalPlayer then
    return
end
local humanoidRootPart5 = boxColor and boxColor:FindFirstChild("HumanoidRootPart")
if not humanoidRootPart5 then
    return
end
local val = CheatState.hitboxEspObjects[player]
if val and val.Parent then
    if val.Adornee == humanoidRootPart5 then
        return
    end val:Destroy()
end
local val = GetPlayerRole(player)
local color = (val == "killer") and Config.hitboxEspKillerColor or Config.hitboxEspSurvivorColor
local selectionBoxObj = Instance.new("SelectionBox")
selectionBoxObj.Adornee = humanoidRootPart5
selectionBoxObj.Color3 = color
selectionBoxObj.LineThickness = 0.05
selectionBoxObj.SurfaceTransparency = Config.hitboxEspOutlineOnly
and 1 or Config.hitboxEspTransparency
selectionBoxObj.SurfaceColor3 = color
selectionBoxObj.Parent = EspFolder
CheatState.hitboxEspObjects[player] = selectionBoxObj
end
local function RemoveHitboxEsp(player)
local hitboxEspAdornee = CheatState.hitboxEspObjects[player]
if hitboxEspAdornee then
    pcall(function()
        hitboxEspAdornee:Destroy()
    end);CheatState.hitboxEspObjects[player] = nil
end
end
local function UpdateHitboxEsp()
for key, value in pairs(CheatState.hitboxEspObjects)do
    if value and value.Parent then
        local val = GetPlayerRole(key)
        local color = (val == "killer") and Config.hitboxEspKillerColor or Config.hitboxEspSurvivorColor
        value.Color3 = color
        value.SurfaceColor3 = color
        value.SurfaceTransparency = Config.hitboxEspOutlineOnly
        and 1 or Config.hitboxEspTransparency
    end
end
end
local function EnableAllHitboxEsp()
for key, value in ipairs(Players:GetPlayers())do
    if value ~= LocalPlayer and value.Character then
        SetupHitboxEsp(value, value.Character)
    end
end
end
