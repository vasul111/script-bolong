            return check:FindFirstChild("Line", true), check:FindFirstChild("Goal", true)
        end
    end
end
end
local val = nil
local function FindSkillCheckActionButton()
if val and val.Parent then
    return val
end
local survivorMobGui = PlayerGui:FindFirstChild("SurvivorMob", true)
if not survivorMobGui then
    return nil
end
local playerGui = survivorMobGui:FindFirstChild("Controls", true)
if not playerGui then
    return nil
end
local guiMob = playerGui:FindFirstChild("action")
if guiMob and guiMob:IsA("GuiButton")then
    val = guiMob
    return guiMob
end guiMob = playerGui:FindFirstChild("GuiMob")
if guiMob and guiMob:IsA("GuiButton")then
    val = guiMob
    return guiMob
end return nil
end
local function SolveInstantSkillCheck()
local val = FindSkillCheckActionButton()
if val and type(firesignal) == "function"then
    firesignal(val.MouseButton1Down)
    task.delay(0.05, function()
        if val and val.Parent then
            firesignal(val.MouseButton1Up)
            firesignal(val.MouseButton1Click)
        end
    end)
    return
end
local check1 = PlayerGui:FindFirstChild("check", true)
if check1 and check1:IsA("GuiObject") and check1.Visible then
    local val = check1.AbsolutePosition
    local val = check1.AbsoluteSize
    local val = GuiService:GetGuiInset()
    local val = val.X + (val.X / 2) + val.X
    local val = val.Y + (val.Y / 2) + val.Y
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(val, val, 0, true, game, 1)
        task.wait(0.01)
        VirtualInputManager:SendMouseButtonEvent(val, val, 0, false, game, 1)
    end)
else
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
    task.wait()
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
end
end RegisterTask("Generator", 0, function()
    if not Config.autoGenerator then
        return
    end
    local lineObject, goalObject = FindSkillCheckUiElements()
    if not(lineObject and goalObject)then
        CheatState.instantLastVisible = false
        CheatState.lastGoalRot = nil
        return
    end
    local goalRotation = goalObject.Rotation
    local lineRotation = lineObject.Rotation
    local currentTime = tick()
    if Config.autoGeneratorMode == "Instant"then
        local instantRotation = goalRotation + 109
        lineObject.Rotation = instantRotation
        if not CheatState.instantLastVisible or goalRotation ~= CheatState.lastGoalRot then
            if currentTime - CheatState.lastPressTime > 0.05 then
                CheatState.lastGoalRot = goalRotation
                CheatState.instantLastVisible = true
                CheatState.lastPressTime = currentTime
                CheatState.lastSkillHit = currentTime
                SolveInstantSkillCheck()
            end
        end
    else
        local val = configMap2.active
        and 0
        or 0.15
        if currentTime - CheatState.lastPressTime < val then
            return
        end
        local val = (lineRotation - goalRotation) % 360
        if Config.autoGeneratorMode == "Normal"then
            if val >= 125 and val <= 140 then
                CheatState.lastPressTime = currentTime
                CheatState.lastSkillHit = currentTime
                SolveInstantSkillCheck()
            end
        else
            if val >= 102 and val <= 109 then
                CheatState.lastPressTime = currentTime
                CheatState.lastSkillHit = currentTime
                SolveInstantSkillCheck()
            end
        end
    end
end)
