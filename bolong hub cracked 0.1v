for key, value in pairs(CheatState.hitboxEspObjects)do
    RemoveHitboxEsp(key)
end
end
local MovementConnections = {antiFall = nil, noSlow = nil}
local function CalculateModifiedWalkSpeed()
if CheatState.SpeedBoost then
    local clamped = math.clamp(CheatState.BoostPercent, 0, 100) * 2
    return DefaultWalkSpeed * (1 + clamped / 100)
end return DefaultWalkSpeed
end
local function SafeSetWalkSpeed(humanoid, targetSpeed)
if not humanoid or not
humanoid.Parent then
    return
end
if math.abs(humanoid.WalkSpeed - targetSpeed) > 0.05 then
    humanoid.WalkSpeed = targetSpeed
end
end

-- ============================================================================
-- MODULE 5: Movement Cheats (Anti-Fall Slow, No Slowdown, God Mode)
-- ============================================================================
local function SetupFallDamageHook()
task.spawn(function()
    local promptPcallSuccess, promptRemoteEvent = pcall(function()
        return game:GetService("ReplicatedStorage"):WaitForChild("Remotes", 10):WaitForChild("Mechanics", 10):WaitForChild("Fall", 10)
    end)
    if not promptPcallSuccess or not
    promptRemoteEvent then
        return
    end
    local val
    val = hookmetamethod(game, "__namecall", function(remote,...)
        local val = getnamecallmethod()
        if CheatState.AntiFallSlow and val == "FireServer"
        and
        rawequal(remote, promptRemoteEvent)then
            return
        end return val(remote,...)
    end)
end)
end
local function EnableAntiFall(character)
if MovementConnections.antiFall then
    MovementConnections.antiFall:Disconnect()
end SetupFallDamageHook()
if not character then
    return
end character:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
MovementConnections.antiFall = character.StateChanged:Connect(function(connection, connection)
    if not CheatState.AntiFallSlow then
        return
    end
    if connection == Enum.HumanoidStateType.Landed or connection == Enum.HumanoidStateType.GettingUp or connection == Enum.HumanoidStateType.FallingDown then
        character:ChangeState(Enum.HumanoidStateType.Running)
        SafeSetWalkSpeed(character, CalculateModifiedWalkSpeed())
    end
end)
end
local function DisableAntiFall(character)
if MovementConnections.antiFall then
    MovementConnections.antiFall:Disconnect();MovementConnections.antiFall = nil
end
if character and character.Parent then
    character:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
end
end
local function EnableNoSlowdown(character)
if MovementConnections.noSlow then
    MovementConnections.noSlow:Disconnect();MovementConnections.noSlow = nil
end
if not character then
    return
end
if GetPlayerRole(LocalPlayer) == "killer"then
    return
end MovementConnections.noSlow = character:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
    if not CheatState.NoSlowdown then
        return
    end
    if GetPlayerRole(LocalPlayer) == "killer"then
        return
    end
    local modifiedSpeed = CalculateModifiedWalkSpeed()
    if character.WalkSpeed < modifiedSpeed - 0.05 then
        pcall(function()
            character.WalkSpeed = modifiedSpeed
        end)
    end
end)
end
local function DisableNoSlowdown()
if MovementConnections.noSlow then
    MovementConnections.noSlow:Disconnect();MovementConnections.noSlow = nil
end
end
local function SetupMovementCheats(character)
if not character then
    return
end
local humanoid = character:WaitForChild("Humanoid", 5)
if not humanoid then
    return
end
if CheatState.AntiFallSlow then
    EnableAntiFall(humanoid)
end
if CheatState.NoSlowdown and GetPlayerRole(LocalPlayer) ~= "killer"then
    EnableNoSlowdown(humanoid)
end
if CheatState.SpeedBoost then
    local val = CalculateModifiedWalkSpeed()
    task.wait(0.15)
    SafeSetWalkSpeed(humanoid, val)
end
end LocalPlayer:GetPropertyChangedSignal("Team"):Connect(function()
    UpdatePlayerRole(LocalPlayer)
    if GetPlayerRole(LocalPlayer) == "killer"
    and
    MovementConnections.noSlow then
        MovementConnections.noSlow:Disconnect()
        MovementConnections.noSlow = nil
    end
end)
local function EnableGodMode()
CheatState.godEnabled = true
CheatState.godLastHP = nil
pcall(function()
    local char = LocalPlayer.Character
    if char then
        local humanoidObj1 = char:FindFirstChildOfClass("Humanoid")
        if humanoidObj1 then
            humanoidObj1:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
            humanoidObj1:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
            humanoidObj1:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
