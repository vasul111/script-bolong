end function Hub.RemoveVisualEffects()
Hub.PostEffectBackups = {}
for key, value in ipairs(Lighting:GetChildren())do
    if value:IsA("PostEffect") or value:IsA("Clouds") or value:IsA("Atmosphere") or value:IsA("Sky")then
        Hub.PostEffectBackups[value] = {Enabled = value.Enabled, Parent = value.Parent}
        pcall(function()
            if value:IsA("Sky")then
                value.Parent = nil
            else
                value.Enabled = false
            end
        end)
    end
end
end function Hub.RestoreVisualEffects()
for key, value in pairs(Hub.PostEffectBackups)do
    if key then
        pcall(function()
            if key:IsA("Sky")then
                key.Parent = value.Parent
            else
                key.Enabled = value.Enabled
            end
        end)
    end
end Hub.PostEffectBackups = {}
