-- ============================================================================
local EnableCameraVeil, DisableCameraVeil, HookMobileButtons, ResetCameraVeilTarget do
    local function GetGuiParent()
    local guiSuccess, guiParent = pcall(function()
        if gethui then
            return gethui()
        end return game:GetService("CoreGui")
    end)
    return(guiSuccess and guiParent) or PlayerGui
end
local function GetCharacterPosition(character)
if not character then
    return nil
end
local head = character:FindFirstChild("Head")
if head then
    return head.Position
end
local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
if humanoidRootPart then
    return humanoidRootPart.Position
end
local upperTorso = character:FindFirstChild("UpperTorso")
if upperTorso then
    return upperTorso.Position
end
local torso = character:FindFirstChild("Torso")
if torso then
    return torso.Position
end return character.PrimaryPart and character.PrimaryPart.Position or nil
end
local function GetCharacterVelocity(character)
if not character then
    return Vector3.new(0, 0, 0)
end
local linearVelocity = character.AssemblyLinearVelocity
local targetPosition = Vector3.new(linearVelocity.X, 0, linearVelocity.Z)
if targetPosition.Magnitude > 65 then
    targetPosition = targetPosition.Unit * 65
end return targetPosition
end
local function GetCameraOrigin()
local localChar = LocalPlayer.Character
local humanoidRootPart1 = localChar and localChar:FindFirstChild("HumanoidRootPart")
if not humanoidRootPart1 then
    return nil
end
local currentCamera = Workspace.CurrentCamera
local targetCFrame = (currentCamera and currentCamera.CFrame.LookVector) or humanoidRootPart1.CFrame.LookVector
return humanoidRootPart1.Position + targetCFrame * 3 + Vector3.new(0, 1.5, 0)
end
local function GetSpearSpeed(distance)
local spearSpeedVal = tonumber(CheatState.CV_LastSpearSpeed) or tonumber(Config.cameraVeilSpearSpeed)
or 220
return math.clamp(spearSpeedVal, 35, 800)
end
local function CalculateTimeToTarget(distanceX, pitchAngle, projectileSpeed, gravityConstant)
local cosPitchAngle = math.cos(pitchAngle)
if cosPitchAngle <= 0.015 then
    return nil, nil
end
local timeToTarget = distanceX / (projectileSpeed * cosPitchAngle)
if timeToTarget ~= timeToTarget or timeToTarget <= 0 then
    return nil, nil
end
local frameTimeDelta = 1 / 60
local gravityCompensation = 0.5 * gravityConstant * frameTimeDelta * timeToTarget
local predictedHeight = projectileSpeed * math.sin(pitchAngle) * timeToTarget - (0.5 * gravityConstant * timeToTarget * timeToTarget) - gravityCompensation
return predictedHeight, timeToTarget
end
local function CheckTrajectoryAccuracy(distanceX, distanceY, pitchAngle, projectileSpeed, gravityConstant)
local calculatedY, flightDuration = CalculateTimeToTarget(distanceX, pitchAngle, projectileSpeed, gravityConstant)
if not calculatedY or not
flightDuration then
    return nil
end
if flightDuration < 0.025 or flightDuration > 4 then
    return nil
end
local heightDelta = math.abs(calculatedY - distanceY)
local anglePenalty = math.max(pitchAngle - Angle42Rad, 0) * 0.35
local timePenalty = math.max(flightDuration - 1.3, 0) * 0.25
return heightDelta + anglePenalty + timePenalty, heightDelta, flightDuration
end
local function CalculateAimDirection(originPos, targetPos, projectileSpeed, gravityConstant)
local targetOffset = targetPos - originPos
local targetPosition1 = Vector3.new(targetOffset.X, 0, targetOffset.Z)
local horizontalDist = targetPosition1.Magnitude
local heightDiff = targetOffset.Y
if targetOffset.Magnitude <= 0.001 then
    return nil
end
if horizontalDist <= 0.35 or gravityConstant <= 0.001 then
    return targetOffset.Unit, math.clamp(targetOffset.Magnitude / projectileSpeed, 0.025, 4)
end
local horizontalDir = targetPosition1.Unit
local directPitchAngle = math.atan2(heightDiff, horizontalDist)
local minSearchPitch = math.max( - Angle28Rad, directPitchAngle - Angle18Rad)
local maxSearchPitch = Angle72Rad
local bestPitch, bestScore, bestDeltaY, bestFlightTime = nil, math.huge, math.huge, nil
local searchSteps = 24
for i = 0, searchSteps do
    local samplePitch = minSearchPitch + (maxSearchPitch - minSearchPitch) * (i / searchSteps)
    local sampleScore, sampleDeltaY, sampleFlightTime = CheckTrajectoryAccuracy(horizontalDist, heightDiff, samplePitch, projectileSpeed, gravityConstant)
    if sampleScore and sampleScore < bestScore then
        bestScore, bestDeltaY, bestPitch, bestFlightTime = sampleScore, sampleDeltaY, samplePitch, sampleFlightTime
        if bestDeltaY < MinTargetDiff then
            break
        end
    end
end
if bestPitch then
    local refineStep = (maxSearchPitch - minSearchPitch) / searchSteps * 2.5
    local refinePasses = (bestDeltaY < MinTargetDiff)
    and 1
    or 3
    for i = 1, refinePasses do
        local curPitch, curScore, curDeltaY, curFlightTime = bestPitch, bestScore, bestDeltaY, bestFlightTime
        for i = - 3, 3 do
            local refinePitch = math.clamp(bestPitch + refineStep * (i / 3), minSearchPitch, maxSearchPitch)
            local fineScore, CalculateAimDirection, fineFlightTime = CheckTrajectoryAccuracy(horizontalDist, heightDiff, refinePitch, projectileSpeed, gravityConstant)
            if fineScore and fineScore < curScore then
                curScore, curDeltaY, curPitch, curFlightTime = fineScore, CalculateAimDirection, refinePitch, fineFlightTime
            end
        end bestPitch, bestScore, bestDeltaY, bestFlightTime = curPitch, curScore, curDeltaY, curFlightTime
        if bestDeltaY < MinTargetDiff then
            break
        end refineStep = refineStep * 0.38
    end
end
if not bestPitch then
    local fallbackFlightTime = math.clamp(horizontalDist / projectileSpeed, 0.025, 4)
    local targetPosition2 = targetPos + Vector3.new(0, 0.5 * gravityConstant * fallbackFlightTime * fallbackFlightTime, 0)
    local fallbackDirection = targetPosition2 - originPos
    if fallbackDirection.Magnitude <= 0.001 then
        return nil
    end return fallbackDirection.Unit, fallbackFlightTime
end
local targetPosition3 = horizontalDir * math.cos(bestPitch) + Vector3.new(0, math.sin(bestPitch), 0)
if targetPosition3.Magnitude <= 0.001 then
    return nil
end return targetPosition3.Unit, bestFlightTime
end
local function PredictTargetAim(targetPos)
local cameraAimOrigin = GetCameraOrigin()
if not cameraAimOrigin or not
targetPos then
    return nil
end
local effectiveSpearSpeed = GetSpearSpeed((targetPos - cameraAimOrigin).Magnitude)
local gravityMult = math.max(tonumber(CheatState.CV_LastGravityMult) or tonumber(Config.cameraVeilGravityMult)
or 1, 0)
local effectiveGravity = GravityConstant * gravityMult
return CalculateAimDirection(cameraAimOrigin, targetPos, effectiveSpearSpeed, effectiveGravity)
end
local function GetAimDirection(targetPos, targetVelocity)
if not targetPos then
    return nil
end
local cameraPosOrigin = GetCameraOrigin()
if cameraPosOrigin then
    local directVector = targetPos - cameraPosOrigin
    local directDistance = directVector.Magnitude
    if directDistance < 6 then
        if directDistance < 0.001 then
            return nil
        end
        local spearSpeedFallback = tonumber(CheatState.CV_LastSpearSpeed) or tonumber(Config.cameraVeilSpearSpeed)
        or 220
        return directVector.Unit, targetPos, math.clamp(directDistance / math.max(spearSpeedFallback, 1), 0.01, 1)
    end
end
local currentFrameIndex = CheatState.CV_frameCount
local frameDelta = currentFrameIndex - CheatState.CV_ballisticFrame
local isTargetClose = CheatState.CV_lastSolvedHeadPos
and (targetPos - CheatState.CV_lastSolvedHeadPos).Magnitude < MaxTargetDiff
if frameDelta < MaxPredictionFrames and isTargetClose and CheatState.CV_lastSolvedDir then
    return CheatState.CV_lastSolvedDir, CheatState.CV_lastSolvedPredicted, CheatState.CV_lastSolvedTime
end
local targetLeadPos = targetPos
local solvedAimDir, solvedFlightTime = PredictTargetAim(targetLeadPos)
if solvedAimDir and solvedFlightTime and targetVelocity and targetVelocity.Magnitude > 1.25 then
    local leadScale = math.clamp(solvedFlightTime * 0.68, 0, 1.1)
    local velocityLeadOffset = targetVelocity * leadScale
    if velocityLeadOffset.Magnitude > 32 then
        velocityLeadOffset = velocityLeadOffset.Unit * 32
    end
    local leadTargetPos = targetPos + velocityLeadOffset
    local refinedAimDir, refinedFlightTime = PredictTargetAim(leadTargetPos)
    if refinedAimDir and refinedFlightTime then
        solvedAimDir, solvedFlightTime, targetLeadPos = refinedAimDir, refinedFlightTime, leadTargetPos
    end
end CheatState.CV_ballisticFrame = currentFrameIndex
CheatState.CV_lastSolvedHeadPos = targetPos
CheatState.CV_lastSolvedDir = solvedAimDir
CheatState.CV_lastSolvedPredicted = targetLeadPos
CheatState.CV_lastSolvedTime = solvedFlightTime
return solvedAimDir, targetLeadPos, solvedFlightTime
end
local IsHoldingSpear
local function GetClosestTarget()
local currentCam = Workspace.CurrentCamera
if not currentCam then
    return nil
end
local cameraPosition, lookVector = currentCam.CFrame.Position, currentCam.CFrame.LookVector
local bestTarget, minAngle = nil, Angle30Rad
local localCharInstance = LocalPlayer.Character
local rootPart = localCharInstance and localCharInstance:FindFirstChild("HumanoidRootPart")
if not rootPart then
    return nil
end for key, value in ipairs(Players:GetPlayers())do
    if value ~= LocalPlayer then
        local playerRoleType = GetPlayerRole(value)
        if playerRoleType == "survivor"then
            local targetPart = value.Character
            local humanoidInstance = targetPart and targetPart:FindFirstChildOfClass("Humanoid")
            if targetPart and humanoidInstance and humanoidInstance.Health > 0 then
                local partPosition = GetCharacterPosition(targetPart)
                if partPosition then
                    local targetDistance = (partPosition - rootPart.Position).Magnitude
                    if targetDistance <= Config.cameraVeilMaxDistance then
                        local distanceVector = partPosition - cameraPosition
                        if distanceVector.Magnitude > 0.001 then
                            local angleDifference = math.acos(math.clamp(lookVector:Dot(distanceVector.Unit), - 1, 1))
                            if angleDifference < minAngle then
                                minAngle = angleDifference
                                bestTarget = value
                            end
                        end
                    end
                end
            end
        end
    end
end return bestTarget
end
local function CreateSnapLine()
if CheatState.CV_SnapGui and CheatState.CV_SnapGui.Parent and CheatState.CV_SnapLine and CheatState.CV_SnapLine.Parent and CheatState.CV_SnapDot and CheatState.CV_SnapDot.Parent then
    return
end
local screenGuiObj = Instance.new("ScreenGui")
screenGuiObj.Name = "CameraVeil_SnapLine"
screenGuiObj.IgnoreGuiInset = true
screenGuiObj.ResetOnSpawn = false
screenGuiObj.Parent = GetGuiParent()
local frameObj = Instance.new("Frame")
frameObj.Name = "Line"
frameObj.AnchorPoint = Vector2.new(0.5, 0.5)
frameObj.BorderSizePixel = 0
frameObj.BackgroundColor3 = Color3.fromRGB(0, 255, 120)
frameObj.BackgroundTransparency = 0.08
frameObj.Visible = false
frameObj.Parent = screenGuiObj
local frameObj1 = Instance.new("Frame")
frameObj1.Name = "Dot"
frameObj1.AnchorPoint = Vector2.new(0.5, 0.5)
frameObj1.BorderSizePixel = 0
frameObj1.BackgroundColor3 = Color3.fromRGB(0, 255, 120)
frameObj1.BackgroundTransparency = 0
frameObj1.Size = UDim2.fromOffset(7, 7)
frameObj1.Visible = false
frameObj1.Parent = screenGuiObj
local uICornerObj = Instance.new("UICorner")
uICornerObj.CornerRadius = UDim.new(1, 0)
uICornerObj.Parent = frameObj1
CheatState.CV_SnapGui = screenGuiObj
CheatState.CV_SnapLine = frameObj
CheatState.CV_SnapDot = frameObj1
end
local function UpdateSnapLine(targetPos)
if not Config.cameraVeilSnapLine or not
CheatState.CV_Enabled then
    if CheatState.CV_SnapLine then
        CheatState.CV_SnapLine.Visible = false
    end
    if CheatState.CV_SnapDot then
        CheatState.CV_SnapDot.Visible = false
    end return
end
if not IsHoldingSpear()then
    if CheatState.CV_SnapLine then
        CheatState.CV_SnapLine.Visible = false
    end
    if CheatState.CV_SnapDot then
        CheatState.CV_SnapDot.Visible = false
    end return
end
local currentFrameIndex = CheatState.CV_frameCount
if targetPos
and (currentFrameIndex - CheatState.CV_snapLineFrame) < 2 then
    return
end CheatState.CV_snapLineFrame = currentFrameIndex
local success = pcall(function()
    CreateSnapLine()
    local snapLineFrame = CheatState.CV_SnapLine
    local snapDotFrame = CheatState.CV_SnapDot
    local camera = Workspace.CurrentCamera
    if not snapLineFrame or not
    camera then
        if snapLineFrame then
            snapLineFrame.Visible = false
        end
        if snapDotFrame then
            snapDotFrame.Visible = false
        end return
    end
    local charPos = targetPos
    local color = (CheatState.CV_CurrentTarget ~= nil and CheatState.CV_WasHolding)
    if not color then
        local closestTarget = GetClosestTarget()
        if closestTarget then
            local char = closestTarget.Character
            if char then
                charPos = GetCharacterPosition(char)
            end
        else
            charPos = nil
        end
    end
    if not charPos then
        snapLineFrame.Visible = false
        if snapDotFrame then
            snapDotFrame.Visible = false
        end return
    end
    local screenViewportPos, isPointOnScreen = camera:WorldToViewportPoint(charPos)
    if not isPointOnScreen or screenViewportPos.Z <= 0 then
        snapLineFrame.Visible = false
        if snapDotFrame then
            snapDotFrame.Visible = false
        end return
    end
    local vec2Point = camera.ViewportSize
    local vec2Point = Vector2.new(vec2Point.X * 0.5, vec2Point.Y * 0.5)
    local vec2Point = Vector2.new(screenViewportPos.X, screenViewportPos.Y)
    local angleVal = vec2Point - vec2Point
    local elementSize = angleVal.Magnitude
    if elementSize < 2 then
        snapLineFrame.Visible = false
        if snapDotFrame then
            snapDotFrame.Visible = false
        end return
    end
    local color = color and Color3.fromRGB(0, 255, 120) or Color3.fromRGB(255, 220, 0)
    local val = color
    and 0.08
    or 0.35
    snapLineFrame.BackgroundColor3 = color
    snapLineFrame.BackgroundTransparency = val
    snapLineFrame.Size = UDim2.fromOffset(elementSize, color
    and 2
    or 1)
    snapLineFrame.Position = UDim2.fromOffset((vec2Point.X + vec2Point.X) * 0.5, (vec2Point.Y + vec2Point.Y) * 0.5)
    snapLineFrame.Rotation = math.deg(math.atan2(angleVal.Y, angleVal.X))
    snapLineFrame.Visible = true
    if snapDotFrame then
        snapDotFrame.BackgroundColor3 = color
        snapDotFrame.Position = UDim2.fromOffset(vec2Point.X, vec2Point.Y)
        snapDotFrame.Visible = true
    end
end)
if not success then
    if CheatState.CV_SnapLine then
        CheatState.CV_SnapLine.Visible = false
    end
    if CheatState.CV_SnapDot then
        CheatState.CV_SnapDot.Visible = false
    end
end
end function ResetCameraVeilTarget()
CheatState.CV_CurrentTarget = nil
CheatState.CV_WasHolding = false
CheatState.CV_LastStableDir = nil
CheatState.CV_acquireStartFrame = nil
UpdateSnapLine(nil)
end IsHoldingSpear = function()
    local val = CheatState.CV_frameCount
    if val == CheatState.CV_spearModeFrame then
        return CheatState.CV_cachedSpearMode
    end CheatState.CV_spearModeFrame = val
    local spearChar = LocalPlayer.Character
    local isToggleActive = false
    if spearChar then
        local spearModeSuccess, isSpearModeActive = pcall(spearChar.GetAttribute, spearChar, "spearmode")
        isToggleActive = spearModeSuccess and isSpearModeActive == true
    end CheatState.CV_cachedSpearMode = isToggleActive
    return isToggleActive
end
local function IsAiming()
if not IsHoldingSpear()then
    return false
end return CheatState.CV_HoldingPC or CheatState.CV_HoldingMobile
end
local function OnRenderStepAim()
CheatState.CV_frameCount = CheatState.CV_frameCount + 1
if not CheatState.CV_Enabled then
    return
end
local val = IsAiming()
if not val then
    if CheatState.CV_WasHolding then
        ResetCameraVeilTarget()
    else
        UpdateSnapLine(nil)
    end return
end
if not CheatState.CV_WasHolding then
    CheatState.CV_LastStableDir = nil
    CheatState.CV_CurrentTarget = GetClosestTarget()
    CheatState.CV_WasHolding = true
    CheatState.CV_acquireStartFrame = CheatState.CV_frameCount
end
if CheatState.CV_acquireStartFrame
and (CheatState.CV_frameCount - CheatState.CV_acquireStartFrame) < AimHoldFrames then
    local closestTarget = GetClosestTarget()
    if closestTarget then
        CheatState.CV_CurrentTarget = closestTarget
    end
end
local char = CheatState.CV_CurrentTarget
if not char then
    CheatState.CV_WasHolding = false
    return
end
local char = char.Character
local humanoidObj = char and char:FindFirstChildOfClass("Humanoid")
local humanoid = GetPlayerRole(char)
if not char or not
humanoidObj or humanoidObj.Health <= 0 or humanoid ~= "survivor"then
    CheatState.CV_WasHolding = false
    CheatState.CV_CurrentTarget = nil
    return
end
local charPos = GetCharacterPosition(char)
if not charPos then
    CheatState.CV_WasHolding = false
    CheatState.CV_CurrentTarget = nil
    return
end
local camera = Workspace.CurrentCamera
local char = LocalPlayer.Character
local humanoidRootPart2 = char and char:FindFirstChild("HumanoidRootPart")
if not camera or not
humanoidRootPart2 then
    return
end
if(charPos - humanoidRootPart2.Position).Magnitude > Config.cameraVeilMaxDistance then
    CheatState.CV_WasHolding = false
    CheatState.CV_CurrentTarget = nil
    return
end
local humanoidRootPart3 = GetCharacterVelocity(char:FindFirstChild("HumanoidRootPart"))
local clamped = GetAimDirection(charPos, humanoidRootPart3)
local val = clamped and clamped.Magnitude > 0.001 and clamped.Y < MaxPitchAngle and clamped.Y > MinPitchAngle
if val then
    if CheatState.CV_LastStableDir then
        local clamped = math.acos(math.clamp(CheatState.CV_LastStableDir:Dot(clamped.Unit), - 1, 1))
        if clamped < Angle45Rad then
            CheatState.CV_LastStableDir = clamped.Unit
        end
    else
        CheatState.CV_LastStableDir = clamped.Unit
    end clamped = CheatState.CV_LastStableDir
elseif CheatState.CV_LastStableDir then
    clamped = CheatState.CV_LastStableDir
else
    clamped = camera.CFrame.LookVector
end
local targetPosition4 = camera.CFrame.Position
local clamped = math.clamp(Config.cameraVeilSmoothness
or 1, 0.05, 1)
local targetCFrame1 = camera.CFrame.LookVector:Lerp(clamped, clamped)
if targetCFrame1.Magnitude > 0.001 then
    camera.CFrame = CFrame.new(targetPosition4, targetPosition4 + targetCFrame1.Unit)
    UpdateSnapLine(charPos)
end
end
local function IsDescendantOfName(instanceObj, ancestorName)
local val = instanceObj and instanceObj.Parent
while val do
    if val.Name == ancestorName then
        return true
    end val = val.Parent
end return false
end
local function IsAttackButton(slasherMobInstance)
if not(slasherMobInstance and slasherMobInstance:IsA("GuiButton"))then
    return false
end
if slasherMobInstance.Name ~= "attack"then
    return false
end
if not IsDescendantOfName(slasherMobInstance, "SlasherMob")then
    return false
end
if not IsDescendantOfName(slasherMobInstance, "Control") and not
IsDescendantOfName(slasherMobInstance, "Controls")then
    return false
end return true
end
local function SetupMobileAttackButton(attackButton)
if not IsAttackButton(attackButton)then
    return
end
if CheatState.CV_HookedButtons[attackButton]then
    return
end CheatState.CV_HookedButtons[attackButton] = true
local function PredictTargetAim()
if not CheatState.CV_Enabled or not
IsHoldingSpear()then
    return
end CheatState.CV_HoldingMobile = true
end
local function HookCameraVeilMovement()
CheatState.CV_HoldingMobile = false
end
local activeConnection = attackButton.InputBegan:Connect(function(targetPlayer)
    local inputState = targetPlayer.UserInputType
    if inputState ~= Enum.UserInputType.Touch and inputState ~= Enum.UserInputType.MouseButton1 then
        return
    end PredictTargetAim()
    local inputObject
    inputObject = UserInputService.InputEnded:Connect(function(connection)
        if connection == targetPlayer then
            HookCameraVeilMovement()
            if inputObject then
                inputObject:Disconnect()
            end
        end
    end)
end)
table.insert(CheatState.CV_Connections, activeConnection)
local activeConnection1 = attackButton.InputEnded:Connect(function(playerRoleType)
    local inputState = playerRoleType.UserInputType
    if inputState ~= Enum.UserInputType.Touch and inputState ~= Enum.UserInputType.MouseButton1 then
        return
    end HookCameraVeilMovement()
end)
table.insert(CheatState.CV_Connections, activeConnection1)
end function HookMobileButtons()
local playerGuiObj = LocalPlayer:FindFirstChildOfClass("PlayerGui") or PlayerGui
if not playerGuiObj then
    return
end pcall(function()
    for key, value in ipairs(playerGuiObj:GetDescendants())do
        SetupMobileAttackButton(value)
    end
end)
if CheatState.CV_WatchConn then
    CheatState.CV_WatchConn:Disconnect()
end CheatState.CV_WatchConn = playerGuiObj.DescendantAdded:Connect(SetupMobileAttackButton)
table.insert(CheatState.CV_Connections, CheatState.CV_WatchConn)
end
local function SetupNetworkAimVisuals()
if CheatState.CV_VisualConn then
    return
end
local remotePcallSuccess, aimVisualRemote = pcall(function()
    local ReplicatedStorageService = game:GetService("ReplicatedStorage")
    local remotes = ReplicatedStorageService:FindFirstChild("Remotes")
    local mechanics = remotes and remotes:FindFirstChild("Mechanics")
    return mechanics and mechanics:FindFirstChild("visualize")
end)
if remotePcallSuccess and aimVisualRemote and aimVisualRemote:IsA("RemoteEvent")then
    CheatState.CV_VisualConn = aimVisualRemote.OnClientEvent:Connect(function(connection, connection, connection, connection)
        if connection ~= LocalPlayer.Character then
            return
        end
        if type(connection) == "number"
        and
        connection > 0 then
            CheatState.CV_LastSpearSpeed = connection
        end
        if type(connection) == "number"
        and
        connection >= 0 then
            CheatState.CV_LastGravityMult = connection
        end
    end)
    table.insert(CheatState.CV_Connections, CheatState.CV_VisualConn)
end
end function EnableCameraVeil()
if CheatState.CV_Enabled then
    return
end CheatState.CV_Enabled = true
CheatState.CV_HoldingPC = false
CheatState.CV_HoldingMobile = false
ResetCameraVeilTarget()
SetupNetworkAimVisuals()
HookMobileButtons()
CheatState.CV_InputBeganConn = UserInputService.InputBegan:Connect(function(connection)
    if connection.UserInputType == Enum.UserInputType.MouseButton2 and IsHoldingSpear()then
        CheatState.CV_HoldingPC = true
    end
end)
table.insert(CheatState.CV_Connections, CheatState.CV_InputBeganConn)
CheatState.CV_InputEndedConn = UserInputService.InputEnded:Connect(function(connection)
    if connection.UserInputType == Enum.UserInputType.MouseButton2 then
        CheatState.CV_HoldingPC = false
    end
end)
table.insert(CheatState.CV_Connections, CheatState.CV_InputEndedConn)
RunService:UnbindFromRenderStep(CheatState.CV_RenderStepName)
pcall(function()
    RunService:BindToRenderStep(CheatState.CV_RenderStepName, Enum.RenderPriority.Camera.Value + 2, OnRenderStepAim)
end)
end function DisableCameraVeil()
CheatState.CV_Enabled = false
CheatState.CV_HoldingPC = false
CheatState.CV_HoldingMobile = false
ResetCameraVeilTarget()
CheatState.CV_frameCount = 0
CheatState.CV_snapLineFrame = - 99
CheatState.CV_spearModeFrame = - 99
CheatState.CV_cachedSpearMode = false
CheatState.CV_ballisticFrame = - 99
CheatState.CV_lastSolvedHeadPos = nil
CheatState.CV_lastSolvedDir = nil
CheatState.CV_lastSolvedPredicted = nil
CheatState.CV_lastSolvedTime = nil
RunService:UnbindFromRenderStep(CheatState.CV_RenderStepName)
for key, value in ipairs(CheatState.CV_Connections)do
    pcall(function()
        value:Disconnect()
    end)
end CheatState.CV_Connections = {}
CheatState.CV_HookedButtons = {}
CheatState.CV_InputBeganConn = nil
CheatState.CV_InputEndedConn = nil
CheatState.CV_WatchConn = nil
CheatState.CV_VisualConn = nil
end
end

-- ============================================================================
-- MODULE 3: Visuals & ESP Engine (Players, Map Objects, Objectives)
-- ============================================================================
local function CreateBillboardGui(adornee, espName, displayText, textColor)
local billboardGuiObj = Instance.new("BillboardGui")
billboardGuiObj.AlwaysOnTop = true
billboardGuiObj.Size = displayText or UDim2.new(0, 40, 0, 40)
billboardGuiObj.StudsOffset = Vector3.new(0, 3.5, 0)
local textLabelObj = Instance.new("TextLabel")
textLabelObj.Name = "Label"
textLabelObj.Size = UDim2.new(1, 0, 1, 0)
textLabelObj.BackgroundTransparency = 1
textLabelObj.Text = adornee
textLabelObj.TextColor3 = espName
textLabelObj.TextStrokeTransparency = 0
textLabelObj.TextStrokeColor3 = Color3.new(0, 0, 0)
textLabelObj.TextSize = textColor
or 22
textLabelObj.Font = Enum.Font.GothamBold
textLabelObj.RichText = true
textLabelObj.Parent = billboardGuiObj
return billboardGuiObj
end
local function UpdatePlayerEsp()
for key, value in pairs(CheatState.espObjects)do
    if value and value.billboard and value.billboard.Parent then
        local val = GetPlayerRole(key)
        local val = val == "killer"
        value.nameLabel.Visible = (val and Config.killerShowName)
        or (not
        val and Config.survivorShowName)
        value.nameLabel.Text = CheatState.pnameEnabled
        and (CheatState.pnameFakeNames[key] or key.Name) or key.Name
        value.billboard.MaxDistance = Config.maxDistance
    end
end for key, value in pairs(CheatState.outlineObjects)do
    if value and value.Parent then
        local val = GetPlayerRole(key)
        local val = val == "killer"
        local val = val and Config.killerColor or Config.survivorColor
        local val = (val and Config.killerShowOutline)
        or (not
        val and Config.survivorShowOutline)
        local val = (val and Config.killerOutlineOnly)
        or (not
        val and Config.survivorOutlineOnly)
        value.FillColor = val
        value.OutlineColor = val
        value.Enabled = val
        value.FillTransparency = val
        and 1 or Config.fillTransparency
    end
end
end
local function SetEspAdornee(espObj, adornee)
local val = CheatState.espObjects[espObj]
if not val or not
val.billboard then
    return
end
local humanoidRootPart4 = adornee:FindFirstChild("HumanoidRootPart") or adornee:WaitForChild("HumanoidRootPart", 5)
if humanoidRootPart4 then
    val.billboard.Adornee = humanoidRootPart4
end
local charModel = GetPlayerRole(espObj)
local val = charModel == "killer"
val.nameLabel.Visible = (val and Config.killerShowName)
or (not
val and Config.survivorShowName)
val.nameLabel.Text = CheatState.pnameEnabled
and (CheatState.pnameFakeNames[espObj] or espObj.Name) or espObj.Name
end
local function SetHighlightOutline(outlineObj, outlineColor)
local val = CheatState.outlineObjects[outlineObj]
if not val then
    return
end
local val = GetPlayerRole(outlineObj)
local val = val == "killer"
local val = val and Config.killerColor or Config.survivorColor
local val = (val and Config.killerShowOutline)
or (not
val and Config.survivorShowOutline)
local val = (val and Config.killerOutlineOnly)
or (not
val and Config.survivorOutlineOnly)
val.Adornee = outlineColor
val.FillColor = val
val.OutlineColor = val
val.FillTransparency = val
and 1 or Config.fillTransparency
val.OutlineTransparency = 0
val.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
val.Enabled = val
end
local function SetupPlayerEsp(player)
if player == LocalPlayer then
    return
end UpdatePlayerRole(player)
local val = GetPlayerRole(player)
local billboardGuiObj1 = Instance.new("BillboardGui")
billboardGuiObj1.Name = "ESP_BB_".. player.Name
billboardGuiObj1.AlwaysOnTop = true
billboardGuiObj1.Size = UDim2.new(0, 150, 0, 18)
billboardGuiObj1.StudsOffset = Vector3.new(0, 3.5, 0)
billboardGuiObj1.MaxDistance = Config.maxDistance
billboardGuiObj1.Parent = EspFolder
local textLabelObj1 = Instance.new("TextLabel")
textLabelObj1.Name = "NameLabel"
textLabelObj1.Size = UDim2.new(1, 0, 0, 18)
textLabelObj1.Position = UDim2.new(0, 0, 0, - 10)
textLabelObj1.BackgroundTransparency = 1
textLabelObj1.TextColor3 = Color3.fromRGB(255, 255, 255)
textLabelObj1.TextStrokeTransparency = 0
textLabelObj1.TextStrokeColor3 = Color3.new(0, 0, 0)
textLabelObj1.TextSize = 12
textLabelObj1.Font = Enum.Font.GothamBold
textLabelObj1.Text = CheatState.pnameEnabled
and (CheatState.pnameFakeNames[player] or player.Name) or player.Name
textLabelObj1.Visible = (val == "killer"
and
Config.killerShowName)
or (val ~= "killer"
and
Config.survivorShowName)
textLabelObj1.Parent = billboardGuiObj1
CheatState.espObjects[player] = {billboard = billboardGuiObj1, nameLabel = textLabelObj1}
if player.Character then
    SetEspAdornee(player, player.Character)
end
if not CheatState.playerTeamConns[player]then
    CheatState.playerTeamConns[player] = player:GetPropertyChangedSignal("Team"):Connect(function()
        UpdatePlayerRole(player)
        UpdatePlayerEsp()
    end)
end
end
local function SetupPlayerOutline(player)
if player == LocalPlayer then
    return
end
local highlightObj = Instance.new("Highlight")
highlightObj.Parent = EspFolder
CheatState.outlineObjects[player] = highlightObj
if player.Character then
    SetHighlightOutline(player, player.Character)
end
end
local function RemovePlayerEsp(player)
if CheatState.espObjects[player]then
    CheatState.espObjects[player]["billboard"]:Destroy()
    CheatState.espObjects[player] = nil
end
if CheatState.outlineObjects[player]then
    CheatState.outlineObjects[player]:Destroy()
    CheatState.outlineObjects[player] = nil
end CheatState.playerRoles[player] = nil
if CheatState.playerTeamConns[player]then
    CheatState.playerTeamConns[player]:Disconnect()
    CheatState.playerTeamConns[player] = nil
end
end
local function GetAttributeOrProperty(instanceObj, attrName)
if typeof(instanceObj) ~= "Instance"then
    return nil
end
local attrValue = instanceObj:GetAttribute(attrName)
if attrValue ~= nil then
    return attrValue
end
local val = instanceObj:FindFirstChild(attrName)
if val and val:IsA("ValueBase")then
    return val.Value
end return nil
end
local function CreateObjectHighlight(targetObj, highlightColor)
if not targetObj or not
targetObj.Parent then
    return
end
local bolongHL = targetObj:FindFirstChild("__BolongHL__")
if not bolongHL then
    bolongHL = Instance.new("Highlight")
    bolongHL.Name = "__BolongHL__"
    bolongHL.Adornee = targetObj
    bolongHL.FillTransparency = 1
    bolongHL.OutlineTransparency = 0
    bolongHL.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    bolongHL.FillColor = highlightColor
    bolongHL.OutlineColor = highlightColor
    bolongHL.Parent = targetObj
    return
end
if bolongHL.FillColor ~= highlightColor then
    bolongHL.FillColor = highlightColor;bolongHL.OutlineColor = highlightColor
end
if not bolongHL.Enabled then
    bolongHL.Enabled = true
end
end
local function RemoveObjectHighlight(targetObj)
if not targetObj then
    return
end
local bolongHL1 = targetObj:FindFirstChild("__BolongHL__")
if bolongHL1 then
    bolongHL1:Destroy()
end
end
local function UpdateGeneratorEspState(generatorObj)
if not generatorObj or not
generatorObj.Parent then
    return true
end
if CheatState.completedGenerators[generatorObj]then
    return true
end
local clamped = GetAttributeOrProperty(generatorObj, "RepairProgress") or GetAttributeOrProperty(generatorObj, "Progress")
or 0
local val = (clamped >= 100)
or (GetAttributeOrProperty(generatorObj, "Completed") == true)
or (GetAttributeOrProperty(generatorObj, "IsCompleted") == true)
or (GetAttributeOrProperty(generatorObj, "Done") == true)
local bolongGenProgress = generatorObj:FindFirstChild("__BolongGenProgress__")
if val or not
Config.espGeneratorEnabled then
    if bolongGenProgress then
        bolongGenProgress:Destroy()
    end RemoveObjectHighlight(generatorObj)
    generatorObj:SetAttribute("__BolongGenLastPct__", nil)
    if val then
        CheatState.completedGenerators[generatorObj] = true
    end return val
end CreateObjectHighlight(generatorObj, Config.espGeneratorColor)
if Config.espGeneratorProgressGen then
    local computedVal = math.floor(clamped .5)
    local attrValue = generatorObj:GetAttribute("__BolongGenLastPct__")
    if attrValue == computedVal and bolongGenProgress then
        return false
    end generatorObj:SetAttribute("__BolongGenLastPct__", computedVal)
    local clamped = math.clamp(clamped, 0, 100)
    local color = (clamped < 50) and Config.espGeneratorColor:Lerp(Color3.fromRGB(255, 200, 0), clamped / 50) or Color3.fromRGB(255, 200, 0):Lerp(Color3.fromRGB(100, 255, 80), (clamped - 50) / 50)
    local val = string.format("%d%%", computedVal)
    local defaultMaterial = generatorObj:FindFirstChild("defaultMaterial", true)
    or (generatorObj:IsA("Model") and generatorObj.PrimaryPart) or generatorObj:FindFirstChildWhichIsA("BasePart")
    if not defaultMaterial then
        return false
    end
    if not bolongGenProgress then
        bolongGenProgress = Instance.new("BillboardGui")
        bolongGenProgress.Name = "__BolongGenProgress__"
        bolongGenProgress.Adornee = defaultMaterial
        bolongGenProgress.AlwaysOnTop = true
        bolongGenProgress.LightInfluence = 0
        bolongGenProgress.ResetOnSpawn = false
        bolongGenProgress.MaxDistance = 260
        bolongGenProgress.Size = UDim2.new(0, 160, 0, 36)
        bolongGenProgress.StudsOffset = Vector3.new(0, 1.95, 0)
        bolongGenProgress.Parent = generatorObj
        local textLabelObj2 = Instance.new("TextLabel")
        textLabelObj2.Name = "Label"
        textLabelObj2.BackgroundTransparency = 1
        textLabelObj2.Size = UDim2.fromScale(1, 1)
        textLabelObj2.Font = Enum.Font.GothamBold
        textLabelObj2.TextSize = 16
        textLabelObj2.Text = val
        textLabelObj2.TextColor3 = color
        textLabelObj2.TextStrokeTransparency = 0
        textLabelObj2.Parent = bolongGenProgress
        local uIStrokeObj = Instance.new("UIStroke")
        uIStrokeObj.Thickness = 1.5
        uIStrokeObj.Transparency = 0.15
        uIStrokeObj.Color = Color3.new(0, 0, 0)
        uIStrokeObj.Parent = textLabelObj2
    else
        local label = bolongGenProgress:FindFirstChild("Label")
        if label then
            label.Text = val
            label.TextColor3 = color
        end
    end
else
    if bolongGenProgress then
        bolongGenProgress:Destroy();generatorObj:SetAttribute("__BolongGenLastPct__", nil)
    end
end return false
end
local function HookGeneratorProgress(generatorObj)
local function UpdateEspBoundingBox()
if not Config.espGeneratorEnabled then
    return
end UpdateGeneratorEspState(generatorObj)
end pcall(function()
    generatorObj:GetAttributeChangedSignal("RepairProgress"):Connect(UpdateEspBoundingBox)
    generatorObj:GetAttributeChangedSignal("Progress"):Connect(UpdateEspBoundingBox)
    generatorObj:GetAttributeChangedSignal("Completed"):Connect(UpdateEspBoundingBox)
    generatorObj:GetAttributeChangedSignal("IsCompleted"):Connect(UpdateEspBoundingBox)
end)
generatorObj.ChildAdded:Connect(function(connection)
    if connection.Name == "RepairProgress"
    or
    connection.Name == "Progress"
    or
    connection.Name == "Completed"
    or
    connection.Name == "IsCompleted"then
        if connection:IsA("ValueBase")then
            connection.Changed:Connect(UpdateEspBoundingBox)
        end UpdateEspBoundingBox()
    end
end)
for key, value in ipairs(generatorObj:GetChildren())do
    if(value.Name == "RepairProgress"
    or
    value.Name == "Progress"
    or
    value.Name == "Completed"
    or
    value.Name == "IsCompleted") and value:IsA("ValueBase")then
        value.Changed:Connect(UpdateEspBoundingBox)
    end
end
end
local function HookPalletState(palletObj, isBroken)
local function ScanMapObjectsLoop()
local attrValue = GetAttributeOrProperty(palletObj, "Dropped") or GetAttributeOrProperty(palletObj, "IsDropped")
local attrValue = GetAttributeOrProperty(palletObj, "Broken") or GetAttributeOrProperty(palletObj, "IsBroken") or GetAttributeOrProperty(palletObj, "Destroyed")
if attrValue or attrValue or isBroken.isFake then
    RemoveObjectHighlight(palletObj)
    for key, value in ipairs(CheatState.cachedMapObjects.Pallets)do
        if value == palletObj then
            table.remove(CheatState.cachedMapObjects.Pallets, key);break
        end
    end CheatState.cachedPalletMeta[palletObj] = nil
end
end for key, value in ipairs( {"Dropped", "IsDropped", "Broken", "IsBroken", "Destroyed"})do
    palletObj:GetAttributeChangedSignal(value):Connect(ScanMapObjectsLoop)
end palletObj.ChildAdded:Connect(function(connection)
    if connection:IsA("ValueBase")
    and (connection.Name == "Dropped"
    or
    connection.Name == "IsDropped"
    or
    connection.Name == "Broken"
    or
    connection.Name == "IsBroken"
    or
    connection.Name == "Destroyed")then
        connection.Changed:Connect(ScanMapObjectsLoop)
    end
end)
end
local function OnMapObjectAdded(mapObj)
local val = mapObj.Name
if val == "Generator"then
    table.insert(CheatState.cachedMapObjects.Generators, mapObj)
    if Config.espGeneratorEnabled then
        UpdateGeneratorEspState(mapObj)
        HookGeneratorProgress(mapObj)
    end
elseif val == "Hook"then
    table.insert(CheatState.cachedMapObjects.Hooks, mapObj)
    local itemList = {}
    local model = mapObj:FindFirstChild("Model")
    if model then
        for key, value in ipairs(model:GetDescendants())do
            if value:IsA("MeshPart")then
                table.insert(itemList, value)
            end
        end
    end CheatState.cachedHookMeshParts[mapObj] = itemList
    if Config.espHookEnabled then
        if#itemList > 0 then
            for key, value in ipairs(itemList)do
                CreateObjectHighlight(value, Config.espHookColor)
            end
        else
            CreateObjectHighlight(mapObj, Config.espHookColor)
        end
    end
elseif val == "Gate"then
    table.insert(CheatState.cachedMapObjects.Gates, mapObj)
    if Config.espGateEnabled then
        CreateObjectHighlight(mapObj, Config.espGateColor)
    end
    if CheatState.ghostGateEnabled then
        ApplyGhostGateToObj(mapObj, true)
    end
elseif val == "Pallet"
or
val == "Palletwrong"then
    table.insert(CheatState.cachedMapObjects.Pallets, mapObj)
    local val = val:lower()
    local rootPart = (mapObj:IsA("Model") and mapObj.PrimaryPart) or mapObj:FindFirstChildWhichIsA("BasePart")
    or (mapObj:IsA("BasePart") and mapObj)
    local val = val:find("fake") or val:find("broken") or val:find("destroyed")
    local configMap = {part = rootPart, isFake = val and true or false}
    CheatState.cachedPalletMeta[mapObj] = configMap
    if Config.espPalletEnabled and not
    configMap.isFake then
        CreateObjectHighlight(mapObj, Config.espPalletColor)
    end HookPalletState(mapObj, configMap)
end
end
local function OnMapObjectRemoved(mapObj)
local val = mapObj.Name
if val == "Generator"then
    for key, value in ipairs(CheatState.cachedMapObjects.Generators)do
        if value == mapObj then
            table.remove(CheatState.cachedMapObjects.Generators, key);break
        end
    end CheatState.completedGenerators[mapObj] = nil
    RemoveObjectHighlight(mapObj)
    local bolongGenProgress1 = mapObj:FindFirstChild("__BolongGenProgress__")
    if bolongGenProgress1 then
        bolongGenProgress1:Destroy()
    end
elseif val == "Hook"then
    for key, value in ipairs(CheatState.cachedMapObjects.Hooks)do
        if value == mapObj then
            table.remove(CheatState.cachedMapObjects.Hooks, key);break
        end
    end
    local collection = CheatState.cachedHookMeshParts[mapObj]
    if collection then
        for key, value in ipairs(collection)do
            RemoveObjectHighlight(value)
        end
    else
        RemoveObjectHighlight(mapObj)
    end CheatState.cachedHookMeshParts[mapObj] = nil
elseif val == "Gate"then
    for key, value in ipairs(CheatState.cachedMapObjects.Gates)do
        if value == mapObj then
            table.remove(CheatState.cachedMapObjects.Gates, key);break
        end
    end RemoveObjectHighlight(mapObj)
elseif val == "Pallet"
or
val == "Palletwrong"then
    for key, value in ipairs(CheatState.cachedMapObjects.Pallets)do
        if value == mapObj then
            table.remove(CheatState.cachedMapObjects.Pallets, key);break
        end
    end RemoveObjectHighlight(mapObj)
    CheatState.cachedPalletMeta[mapObj] = nil
end
end
local function ScanMapObjects(objectCategory)
if not objectCategory then
    return
