local function GetClosestLockTarget(targetType)
local char = LocalPlayer.Character
local humanoidRootPart10 = char and char:FindFirstChild("HumanoidRootPart")
if not humanoidRootPart10 then
    return nil
end
local targetPosition6 = humanoidRootPart10.Position
local val = 0.1
local val = nil
