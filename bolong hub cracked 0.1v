local function HasEquippedDagger()
local backpack = LocalPlayer:FindFirstChild("Backpack")
local equippedDagger = backpack and backpack:FindFirstChild(daggerToolName)
if not equippedDagger then
    local localPlayerCharacter = LocalPlayer.Character
    local characterDagger = localPlayerCharacter and localPlayerCharacter:FindFirstChild(daggerToolName)
    if characterDagger and characterDagger:IsDescendantOf(localPlayerCharacter)then
        equippedDagger = characterDagger
    end
end return equippedDagger ~= nil
end
local function IsLungeHoldAnimation(animTrack)
local animationInstance = animTrack.Animation
if not animationInstance then
    return false
end
local rawAnimName = animationInstance.Name
if rawAnimName then
    local normalizedAnimName = rawAnimName:lower():gsub("%s+", "")
    if normalizedAnimName == "lungehold"then
        return true
    end
end return false
end
local function IsParriableAttackAnimation(animTrack)
local attackAnimInstance = animTrack.Animation
if not attackAnimInstance then
    return false
end
local rawAttackAnimName = attackAnimInstance.Name
if rawAttackAnimName then
    local cleanAttackAnimName = rawAttackAnimName:lower():gsub("%s+", "")
    if cleanAttackAnimName == "lungehold"then
        return true
    end for key, value in ipairs(itemList5)do
        if cleanAttackAnimName == value then
            return true
        end
    end
end
local attackAnimId = attackAnimInstance.AnimationId
if attackAnimId then
    local parsedAnimId = tostring(attackAnimId):match("%d+")
    if parsedAnimId and configMap3[parsedAnimId]then
        return true
    end
end return false
