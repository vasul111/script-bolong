local function DisableGodMode()
CheatState.godEnabled = false
CheatState.godLastHP = nil
pcall(function()
    local char = LocalPlayer.Character
    if not char then
        return
    end
    local humanoidObj2 = char:FindFirstChildOfClass("Humanoid")
    if not humanoidObj2 then
