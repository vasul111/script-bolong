local function IsWorldPointInScreenRadius(cameraObj, worldPos, fovRadius)
local fovScreenPos, fovIsOnScreen = cameraObj:WorldToViewportPoint(worldPos)
if not fovIsOnScreen then
    return false
end
local screenCenterPos = Vector2.new(cameraObj.ViewportSize.X / 2, cameraObj.ViewportSize.Y / 2)
local screenPointVector = Vector2.new(fovScreenPos.X, fovScreenPos.Y)
local screenDistanceFromCenter = (screenPointVector - screenCenterPos).Magnitude
return screenDistanceFromCenter <= fovRadius
end
