end RegisterTask("AutoParryPoll", 0, function()
    if not CheatState.autoParryEnabled then
        return
    end
    if AutoParryState.Cooldown then
        return
    end
    local char = LocalPlayer.Character
    if not char then
        return
    end
    local humanoidRootPart18 = char:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart18 then
        return
    end
    local targetPosition16 = humanoidRootPart18.Position
    for key, value in ipairs(Players:GetPlayers())do
        if value == LocalPlayer then
            continue
        end
        if GetPlayerRole(value) ~= "killer"then
            continue
        end
        local char = value.Character
        if not char then
            continue
        end
        local humanoidRootPart19 = char:FindFirstChild("HumanoidRootPart")
        if not humanoidRootPart19 then
            continue
        end
        local targetPosition17 = (humanoidRootPart19.Position - targetPosition16).Magnitude
        if targetPosition17 > CheatState.autoParryRadius then
            continue
        end
        if not Hub.IsTargetFacingMe(char)then
            continue
        end
        local humanoidObj12 = char:FindFirstChildOfClass("Humanoid")
        if not humanoidObj12 then
            continue
        end
        local attackerCharacter = AutoParryState.KillerBlacklist[humanoidObj12]
        if attackerCharacter
        and (tick() - attackerCharacter) < AutoParryState.BLACKLIST_DURATION then
            continue
        end
        local parryChildrenSuccess, attackerChildren = pcall(function()
            return humanoidObj12:GetPlayingAnimationTracks()
        end)
        if not parryChildrenSuccess or not
        attackerChildren then
            continue
        end
        local daggerTool = false
        local isToggleActive3 = false
        for key, value in ipairs(attackerChildren)do
            if IsLungeHoldAnimation(value)then
                daggerTool = true
                break
            end
            if not isToggleActive3 and IsParriableAttackAnimation(value)then
                isToggleActive3 = true
            end
        end
        if not daggerTool and not
        isToggleActive3 then
            continue
        end
        if not Hub.HasLineOfSight(char)then
            continue
        end Hub.ParryAttack(humanoidObj12)
        break
    end
end)
