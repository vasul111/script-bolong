local crosshairTypes = {"Plus", "Cross (X)", "Dot", "Circle", "Circle + Dot", "T-Shape", "Square"}
local CrosshairState = {LastStyle = nil, LastSize = nil, Frames = {}, Strokes = {}, DotFrames = {}}
local function ClearCrosshair(collection)
for key, value in ipairs(collection:GetChildren())do
    value:Destroy()
end CrosshairState.Frames = {};CrosshairState.Strokes = {};CrosshairState.DotFrames = {}
end
local function DrawCrosshair(crosshairType, selectedCrosshair, crosshairSize, lineColor, opacityVal)
local baseCrossWidth, baseCrossHeight = 40, 40
local function DrawCustomCrosshairShape(screenX, screenY, lineLength, lineThickness, lineColor)
local elementSize = math.max(1, math.round(lineLength * opacityVal))
local crossThickness = math.max(1, math.round(lineThickness * opacityVal))
local part = math.round(baseCrossWidth + screenX * opacityVal - elementSize * 0.5)
local crossOffsetY = math.round(baseCrossHeight + screenY * opacityVal - crossThickness * 0.5)
local frameObj3 = Instance.new("Frame")
frameObj3.BackgroundColor3 = lineColor or crosshairSize
frameObj3.BackgroundTransparency = lineColor
frameObj3.BorderSizePixel = 0
frameObj3.Size = UDim2.fromOffset(elementSize, crossThickness)
frameObj3.Position = UDim2.fromOffset(part, crossOffsetY)
frameObj3.Parent = crosshairType
table.insert(CrosshairState.Frames, frameObj3)
return frameObj3
end
if selectedCrosshair == "Plus"then
    DrawCustomCrosshairShape(0, 0, 8 * 2 + 3, 3);DrawCustomCrosshairShape(0, 0, 3, 8 * 2 + 3)
    local color = DrawCustomCrosshairShape(0, 0, 3 + 2, 3 + 2)
    color.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    CrosshairState.DotFrames[color] = true
elseif selectedCrosshair == "Cross (X)"then
    local barWidth = math.max(1, math.round(20 * opacityVal))
    local barHeight = math.max(1, math.round(3 * opacityVal))
    for key, value in ipairs( {45, - 45})do
        local frameObj4 = Instance.new("Frame")
        frameObj4.BackgroundColor3 = crosshairSize;frameObj4.BackgroundTransparency = lineColor;frameObj4.BorderSizePixel = 0
        frameObj4.Size = UDim2.fromOffset(barWidth, barHeight);frameObj4.Position = UDim2.fromOffset(baseCrossWidth - math.round(barWidth * 0.5), baseCrossHeight - math.round(barHeight * 0.5))
        frameObj4.Rotation = value;frameObj4.Parent = crosshairType
        table.insert(CrosshairState.Frames, frameObj4)
    end
elseif selectedCrosshair == "Dot"then
    local val = DrawCustomCrosshairShape(0, 0, 5 * 2, 5 * 2)
    local uICornerObj2 = Instance.new("UICorner");uICornerObj2.CornerRadius = UDim.new(1, 0);uICornerObj2.Parent = val
elseif selectedCrosshair == "Circle"then
    local dotRadius = math.max(6, math.round(10 * opacityVal))
    local frameObj5 = Instance.new("Frame")
    frameObj5.BackgroundTransparency = 1;frameObj5.Size = UDim2.fromOffset(dotRadius * 2, dotRadius * 2);frameObj5.Position = UDim2.fromOffset(baseCrossWidth - dotRadius, baseCrossHeight - dotRadius);frameObj5.Parent = crosshairType
    local uICornerObj3 = Instance.new("UICorner");uICornerObj3.CornerRadius = UDim.new(1, 0);uICornerObj3.Parent = frameObj5
    local uIStrokeObj2 = Instance.new("UIStroke")
    uIStrokeObj2.Color = crosshairSize;uIStrokeObj2.Thickness = math.max(2, math.round(2.5 * opacityVal));uIStrokeObj2.Transparency = lineColor;uIStrokeObj2.Parent = frameObj5
    table.insert(CrosshairState.Strokes, uIStrokeObj2)
elseif selectedCrosshair == "Circle + Dot"then
    local boxRadius = math.max(6, math.round(10 * opacityVal))
    local frameObj6 = Instance.new("Frame")
    frameObj6.BackgroundTransparency = 1;frameObj6.Size = UDim2.fromOffset(boxRadius * 2, boxRadius * 2);frameObj6.Position = UDim2.fromOffset(baseCrossWidth - boxRadius, baseCrossHeight - boxRadius);frameObj6.Parent = crosshairType
    local uICornerObj4 = Instance.new("UICorner");uICornerObj4.CornerRadius = UDim.new(1, 0);uICornerObj4.Parent = frameObj6
    local uIStrokeObj3 = Instance.new("UIStroke")
    uIStrokeObj3.Color = crosshairSize;uIStrokeObj3.Thickness = math.max(2, math.round(2.5 * opacityVal));uIStrokeObj3.Transparency = lineColor;uIStrokeObj3.Parent = frameObj6
    table.insert(CrosshairState.Strokes, uIStrokeObj3)
    local computedVal = math.max(3, math.round(3 * opacityVal))
    local val = DrawCustomCrosshairShape(0, 0, computedVal * 2, computedVal * 2)
    local uICornerObj5 = Instance.new("UICorner");uICornerObj5.CornerRadius = UDim.new(1, 0);uICornerObj5.Parent = val
elseif selectedCrosshair == "T-Shape"then
    DrawCustomCrosshairShape(0, - 4, 3, 8);DrawCustomCrosshairShape(0, 0, 8 * 2 + 3, 3)
elseif selectedCrosshair == "Square"then
    local bracketOffset, bracketLength, bracketThickness = 10, 6, 3
    DrawCustomCrosshairShape( - (bracketOffset - bracketLength * 0.5), - bracketOffset, bracketLength, bracketThickness);DrawCustomCrosshairShape( - bracketOffset, - (bracketOffset - bracketLength * 0.5), bracketThickness, bracketLength)
    DrawCustomCrosshairShape((bracketOffset - bracketLength * 0.5), - bracketOffset, bracketLength, bracketThickness);DrawCustomCrosshairShape(bracketOffset, - (bracketOffset - bracketLength * 0.5), bracketThickness, bracketLength)
    DrawCustomCrosshairShape( - (bracketOffset - bracketLength * 0.5), bracketOffset, bracketLength, bracketThickness);DrawCustomCrosshairShape( - bracketOffset, (bracketOffset - bracketLength * 0.5), bracketThickness, bracketLength)
    DrawCustomCrosshairShape((bracketOffset - bracketLength * 0.5), bracketOffset, bracketLength, bracketThickness);DrawCustomCrosshairShape(bracketOffset, (bracketOffset - bracketLength * 0.5), bracketThickness, bracketLength)
end
end
local function UpdateCrosshairColors(colorVal, opacityVal)
for key, value in ipairs(CrosshairState.Frames)do
    if value and value.Parent then
        if not CrosshairState.DotFrames[value]then
            value.BackgroundColor3 = colorVal
        end value.BackgroundTransparency = opacityVal
    end
end for key, value in ipairs(CrosshairState.Strokes)do
    if value and value.Parent then
        value.Color = colorVal;value.Transparency = opacityVal
    end
end
end
local function RenderCrosshair(centerPosX, centerPosY, crosshairStyle)
local val = CheatState.CrosshairColor
local val = 1 - crosshairStyle
local val = 0.4 + (CheatState.CrosshairSize / 100) .1
if centerPosY ~= CrosshairState.LastStyle or CheatState.CrosshairSize ~= CrosshairState.LastSize then
    ClearCrosshair(centerPosX)
    DrawCrosshair(centerPosX, centerPosY, val, val, val)
    CrosshairState.LastStyle = centerPosY
    CrosshairState.LastSize = CheatState.CrosshairSize
else
    UpdateCrosshairColors(val, val)
end
end
