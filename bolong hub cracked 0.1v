frameObj7.BackgroundTransparency = 1;frameObj7.BorderSizePixel = 0;frameObj7.Position = UDim2.new(CheatState.CrosshairPosX, 0, CheatState.CrosshairPosY, 0);frameObj7.Parent = screenGuiObj2
