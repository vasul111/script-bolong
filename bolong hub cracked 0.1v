local TaskLoops = {}
local function RegisterTask(taskName, taskInterval, animName)
TaskLoops[#TaskLoops + 1] = {name = taskName, interval = taskInterval, timer = 0, fn = animName}
end
local function GetPlayerRole(player)
return CheatState.playerRoles[player]
or "survivor"
end
local function UpdatePlayerRole(player)
local success, result = pcall(function()
    return player.Team and player.Team.Name:lower()
    or ""
end)
CheatState.playerRoles[player] = (success and result:find("killer"))
and "killer"
or "survivor"
end
local function GetPlayerColor(playerRole)
return GetPlayerRole(playerRole) == "killer"
and
Config.killerColor or Config.survivorColor
end

