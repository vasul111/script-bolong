        return
    end
    local inputState = KeyCodeToString(Config.forceCursorKeybind)
    local inputState = StringToKeyCode(inputState)
    if inputState and connection.KeyCode == inputState then
        SetForceCursor(not
        Config.forceCursorEnabled, true)
    end
end)
