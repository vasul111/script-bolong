    gateEspSection:AddColorPicker( {Title = "Hook Color", Default = Config.espHookColor, Callback = function(controlState)
        Config.espHookColor = controlState
        for key, value in ipairs(CheatState.cachedMapObjects.Hooks)do
            if value and value.Parent then
                local collection = CheatState.cachedHookMeshParts[value]
                if collection then
                    for key, value in ipairs(collection)do
                        local bolongHL4 = value:FindFirstChild("__BolongHL__")
                        if bolongHL4 then
                            bolongHL4.FillColor = controlState;bolongHL4.OutlineColor = controlState
                        end
                    end
                end
            end
        end
    end,})
    gateEspSection:AddColorPicker( {Title = "Gate Color", Default = Config.espGateColor, Callback = function(controlState)
        Config.espGateColor = controlState
        for key, value in ipairs(CheatState.cachedMapObjects.Gates)do
            if value and value.Parent then
                local bolongHL5 = value:FindFirstChild("__BolongHL__")
                if bolongHL5 then
                    bolongHL5.FillColor = controlState;bolongHL5.OutlineColor = controlState
                end
            end
        end
    end,})
    local performanceMonitorSection = Hub.VisualTab:AddSection( "World Settings", nil)
    performanceMonitorSection:AddToggle( {Title = "Fullbright", Default = false, Callback = function(controlState)
        CheatState.fullbrightEnabled = controlState
        if controlState then
            Hub.EnableFullbright()
        else
            Hub.DisableFullbright()
        end
    end,})
    performanceMonitorSection:AddToggle( {Title = "Remove Visual Effects", Content = "BoostFps", Default = false, Callback = function(controlState)
        CheatState.removeVfxEnabled = controlState
        if controlState then
            Hub.RemoveVisualEffects()
        else
            Hub.RestoreVisualEffects()
        end
    end,})
end do
    local controlState = Hub.MiscTab:AddSection( "Killer Warn", nil)
    controlState:AddToggle( {Title = "Enable Killer Warn", Content = "The ! sign above your head when the killer is around you", Default = Config.warnEnabled, Callback = function(controlState)
        Config.warnEnabled = controlState
    end,})
    local cameraZoomSection = Hub.MiscTab:AddSection( "Performance Monitor", nil)
    cameraZoomSection:AddToggle( {Title = "Show Performance Window", Default = false, Callback = function(controlState)
        if controlState then
            EnablePerfMonitor()
        else
            DisablePerfMonitor()
        end
    end,})
    local inputState = Hub.MiscTab:AddSection( "Cursor Features", nil)
    inputState:AddToggle( {Title = "Enable Force Cursor", Default = Config.forceCursorEnabled, Callback = function(controlState)
        SetForceCursor(controlState, false)
    end,})
    inputState:AddKeybind( {Title = "Custom Cursor Keybind", Content = "Tekan keybind ini untuk toggle Force Cursor ON/OFF", Default = Enum.KeyCode[Config.forceCursorKeybind] or Enum.KeyCode.G, Callback = function(inputState)
        Config.forceCursorKeybind = inputState.Name
        ShowNotification("Cursor Keybind", "Keybind diubah ke: ".. Config.forceCursorKeybind, 1.5)
    end,})
    local forceCursorSection = Hub.MiscTab:AddSection( "Camera Zoom", nil)
    forceCursorSection:AddToggle( {Title = "Max Camera Zoom", Default = Config.cameraZoomEnabled, Callback = function(SetMaxZoom)
        Config.cameraZoomEnabled = SetMaxZoom
        if SetMaxZoom then
            SetMaxZoom(Config.cameraZoomValue)
        else
            ResetMaxZoom()
        end
    end,})
    local controlState = Hub.MiscTab:AddSection( "Protect Name", nil)
    controlState:AddToggle( {Title = "Enable Protect Name", Default = false, Callback = function(EnableNameProtect)
        if EnableNameProtect then
            EnableNameProtect()
        else
            DisableNameProtect()
        end
    end,})
    local nameProtectSection = Hub.MiscTab:AddSection( "Skip End Screen", nil)
    nameProtectSection:AddToggle( {Title = "Skip End Screen", Content = "Bypass cutscene", Default = false, Callback = function(skipEndScreenEnabled)
        Config.skipEndScreenEnabled = skipEndScreenEnabled
        if skipEndScreenEnabled then
            EnableSkipEndScreen()
        else
            DisableSkipEndScreen()
        end
    end,})
end do
    local val = Hub.ConfigTab:AddSection( "Configuration", true)
    val:AddConfig()
end print("BOLONGHUB LOADED!")
