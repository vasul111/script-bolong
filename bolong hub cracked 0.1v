    end humanoidObj2:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
    humanoidObj2:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
    humanoidObj2:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
end)
end RegisterTask("GodMode", 0.2, function()
    if not CheatState.godEnabled then
        return
    end
    local char = LocalPlayer.Character
    if not char then
        return
    end
    local humanoidObj3 = char:FindFirstChildOfClass("Humanoid")
    if not humanoidObj3 then
        return
    end
    local godHealthBackup = humanoidObj3.MaxHealth
    local humanoid = humanoidObj3.Health
    if CheatState.godLastHP ~= nil and humanoid < CheatState.godLastHP and humanoid > 0 then
        pcall(function()
            humanoidObj3.Health = godHealthBackup
        end)
    end CheatState.godLastHP = humanoidObj3.Health
    pcall(function()
        local val = humanoidObj3:GetState()
        if val == Enum.HumanoidStateType.Dead then
            humanoidObj3.Health = godHealthBackup
            humanoidObj3:ChangeState(Enum.HumanoidStateType.Running)
            CheatState.godLastHP = godHealthBackup
        elseif val == Enum.HumanoidStateType.Ragdoll or val == Enum.HumanoidStateType.FallingDown then
            humanoidObj3:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
    end)
end)
