-- ============================================================================
-- MODULE 9: Name Protection & Cutscene Bypass
-- ============================================================================
local function GetOrAssignFakeName(player)
if not CheatState.pnameFakeNames[player]then
    local fakeNameIndex = (#CheatState.pnameFakeNames % #fakeNamesList) + 1
    CheatState.pnameFakeNames[player] = fakeNamesList[fakeNameIndex]
end return CheatState.pnameFakeNames[player]
end
local function UpdateCharacterNameTag(character, assignedFakeName)
if not character then
    return
end
local head1 = character:FindFirstChild("Head")
if not head1 then
    return
end for key, value in ipairs(head1:GetChildren())do
    if value:IsA("BillboardGui")then
        local nameTextLabel = value:FindFirstChildWhichIsA("TextLabel")
        if nameTextLabel then
            nameTextLabel.Text = assignedFakeName
        end
    end
end
local humanoidObj9 = character:FindFirstChildOfClass("Humanoid")
if humanoidObj9 then
    pcall(function()
        humanoidObj9.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
    end)
end
end
local function RestoreCharacterNameTag(character, originalName)
if not character then
    return
end
local head2 = character:FindFirstChild("Head")
if head2 then
    for key, value in ipairs(head2:GetChildren())do
        if value:IsA("BillboardGui")then
            local textLabel = value:FindFirstChildWhichIsA("TextLabel")
            if textLabel then
                textLabel.Text = originalName
            end
        end
    end
end
local humanoidObj10 = character:FindFirstChildOfClass("Humanoid")
if humanoidObj10 then
    pcall(function()
        humanoidObj10.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Limit
    end)
end
end
local function GetSurvivorNameLabel(userId)
local survivorMobGui = PlayerGui:FindFirstChild("SurvivorMob")
if not survivorMobGui then
    return nil
end
local frame = survivorMobGui:FindFirstChild("Frame")
if not frame then
    return nil
end for i = 1, 5 do
    local survivor = frame:FindFirstChild("Survivor".. i)
    if survivor and survivor:GetAttribute("UserId") == userId then
        return survivor:FindFirstChild("TextLabel")
    end
end return nil
end
local function UpdatePlayerDisplayName(targetPlayer)
local val = (targetPlayer == LocalPlayer)
local char = GetOrAssignFakeName(targetPlayer)
if not val then
    if CheatState.espObjects[targetPlayer]then
        CheatState.espObjects[targetPlayer]["nameLabel"]Text = char
    end
    if targetPlayer.Character then
        UpdateCharacterNameTag(targetPlayer.Character, char)
    end
end
local val = GetSurvivorNameLabel(targetPlayer.UserId)
if val then
    val.Text = char
end
if not val and not
CheatState.pnameNameConns[targetPlayer]then
    CheatState.pnameNameConns[targetPlayer] = targetPlayer.CharacterAdded:Connect(function(character)
        if not CheatState.pnameEnabled then
            return
        end
        local val = GetOrAssignFakeName(targetPlayer)
        task.wait(0.5)
        UpdateCharacterNameTag(character, val)
        if CheatState.espObjects[targetPlayer]then
            CheatState.espObjects[targetPlayer]["nameLabel"]Text = val
        end
        local val = GetSurvivorNameLabel(targetPlayer.UserId)
        if val then
            val.Text = val
        end
    end)
end
end
local function UpdatePlayerNameTag(targetPlayer)
local assignedFakeName = (targetPlayer == LocalPlayer)
local displayFakeName = targetPlayer.Name
if not assignedFakeName then
    if CheatState.espObjects[targetPlayer]then
        CheatState.espObjects[targetPlayer]["nameLabel"]Text = displayFakeName
    end
    if targetPlayer.Character then
        RestoreCharacterNameTag(targetPlayer.Character, displayFakeName)
    end
    if CheatState.pnameNameConns[targetPlayer]then
        CheatState.pnameNameConns[targetPlayer]:Disconnect()
        CheatState.pnameNameConns[targetPlayer] = nil
    end
end
local survivorNameLabel = GetSurvivorNameLabel(targetPlayer.UserId)
if survivorNameLabel then
    survivorNameLabel.Text = displayFakeName
end
end
local function MonitorNameSlotUI(slotFrame, slotIndex)
local connection = slotFrame.Name
if CheatState.pnameSlotConns[connection]then
    CheatState.pnameSlotConns[connection]:Disconnect()
    CheatState.pnameSlotConns[connection] = nil
end
local attrValue = slotFrame:GetAttribute("UserId")
if not attrValue then
