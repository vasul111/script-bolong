local part = nil
local val = math.huge
for key, value in ipairs(CheatState.cachedMapObjects.Gates)do
    if value and value.Parent then
        local rootPart = (value:IsA("Model") and value.PrimaryPart)
        or (value:IsA("BasePart") and value) or value:FindFirstChildWhichIsA("BasePart")
        if rootPart then
