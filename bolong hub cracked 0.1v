local function StringToKeyCode(keyName)
if type(keyName) ~= "string"then
    return nil
end for key, value in ipairs(Enum.KeyCode:GetEnumItems())do
    if value.Name == keyName then
        return value
    end
end return nil
end
local function KeyCodeToString(keyCodeVal)
if typeof(keyCodeVal) == "EnumItem"
and
keyCodeVal.EnumType == Enum.KeyCode then
    return keyCodeVal.Name
end
if type(keyCodeVal) == "string"then
    local inputState = keyCodeVal:gsub("^Enum%.KeyCode%.", "")
    if StringToKeyCode(inputState)then
        return inputState
    end
end return Config.forceCursorKeybind
end
local function ForceCursorProperties()
pcall(function()
    UserInputService.MouseIconEnabled = true
end)
pcall(function()
    UserInputService.MouseBehavior = Enum.MouseBehavior.Default
end)
end
local function SetForceCursor(isForceEnabled, triggerKeybind)
Config.forceCursorEnabled = isForceEnabled and true or false
if Config.forceCursorEnabled then
    if CheatState.cursorBackupIcon == nil then
        local cursorPcallSuccess, origCursorIcon = pcall(function()
            return UserInputService.MouseIconEnabled
        end)
        CheatState.cursorBackupIcon = cursorPcallSuccess and origCursorIcon or true
    end
    if CheatState.cursorBackupBehavior == nil then
        local mousePcallSuccess, origMouseBehavior = pcall(function()
            return UserInputService.MouseBehavior
        end)
        CheatState.cursorBackupBehavior = mousePcallSuccess and origMouseBehavior or Enum.MouseBehavior.Default
    end ForceCursorProperties()
else
    if CheatState.cursorBackupIcon ~= nil then
        pcall(function()
            UserInputService.MouseIconEnabled = CheatState.cursorBackupIcon
        end)
        CheatState.cursorBackupIcon = nil
    end
    if CheatState.cursorBackupBehavior ~= nil then
        pcall(function()
            UserInputService.MouseBehavior = CheatState.cursorBackupBehavior
        end)
        CheatState.cursorBackupBehavior = nil
    end
end
if triggerKeybind then
    ShowNotification("Cursor Features", Config.forceCursorEnabled
    and "Force Cursor: ON"
    or "Force Cursor: OFF", 1.5)
end
end UserInputService:GetPropertyChangedSignal("MouseBehavior"):Connect(function()
    if Config.forceCursorEnabled then
        ForceCursorProperties()
    end
end)
UserInputService:GetPropertyChangedSignal("MouseIconEnabled"):Connect(function()
    if Config.forceCursorEnabled then
        ForceCursorProperties()
    end
end)
UserInputService.InputBegan:Connect(function(connection, connection)
    if connection then
        return
    end
    if UserInputService:GetFocusedTextBox()then
